{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "caseSensitive": false,
  "allowCompoundWords": false,
  "dictionaries": ["en_US", "en-gb", "softwareTerms", "typescript", "python", "node", "html", "css", "shelf-life", "shelf-life-api"],
  "dictionaryDefinitions": [
    {
      "name": "shelf-life",
      "description": "Proper names and domain terms written on purpose in Shelf Life player text.",
      "addWords": false,
      "words": [
        "Shelby",
        "Atlas",
        "Pellan",
        "Chebyshev",
        "Zustand",
        "Fraunces",
        "Undercase",
        "unshelved",
        "unshuffled",
        "Almanac",
        "Hatchling",
        "Hatchlings",
        "Bookplate",
        "Bookends",
        "Timewarp",
        "Pyodide",
        "NumPy",
        "datascience",
        "Jupyter",
        "IndexedDB",
        "CodeMirror",
        "quartile",
        "quartiles",
        "percentile",
        "percentiles",
        "bootstrapped",
        "resample",
        "resampled",
        "resamples",
        "resampling",
        "scatterplot",
        "histogram",
        "histograms",
        "colorblind",
        "deuteranopia",
        "protanopia",
        "tritanopia",
        "roundtrip",
        "autosave",
        "autosaves",
        "autosaved"
      ]
    },
    {
      "name": "shelf-life-api",
      "description": "Function, option and algorithm names quoted inside player-facing explanations.",
      "addWords": false,
      "words": ["barh", "BFGS", "maxfev", "maxiter", "gtol", "ftol", "xtol", "ndigits", "arange", "dtype", "argmax", "argmin", "astype", "isin", "nanmean", "pyodide"]
    }
  ],
  "ignoreRegExpList": [
    "/`[^`]*`/g",
    "/\\bhttps?:\\/\\/\\S+/g",
    "/\\b[\\w.-]+\\.(py|ts|tsx|json|glb|mjs|html|css|md)\\b/g",
    "/\\b\\w+_\\w[\\w_]*\\b/g",
    "/\\b(?:np|pd|Table|table|array|self|shelf|loans)\\.\\w+/g",
    "/\\b\\w+\\(\\)/g",
    "/&#?\\w+;/g",
    "/\\bU\\+[0-9A-Fa-f]+\\b/g"
  ],
  "ignorePaths": ["node_modules/**", "dist/**", "public/**", "package-lock.json"],
  "words": []
}
